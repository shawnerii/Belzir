{
  "name": "belzir-backend-soc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx node_modules/.bin/knex --knexfile knexfile.ts migrate:latest",
    "seed": "tsx node_modules/.bin/knex --knexfile knexfile.ts seed:run",
    "reset:test-data": "tsx scripts/reset-test-data.ts",
    "verify": "tsx node_modules/.bin/knex --knexfile knexfile.ts migrate:latest && tsx node_modules/.bin/knex --knexfile knexfile.ts seed:run && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
